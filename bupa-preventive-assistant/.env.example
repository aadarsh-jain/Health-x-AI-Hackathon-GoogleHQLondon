# =========================================================================
# EXAMPLE environment config for the Cloud Run API (read by api/config.py).
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is git-ignored — never commit real project IDs, DB URLs or secrets.
#
# api/config.py reads these via os.getenv, so make them available to the
# process. Options:
#   - export them in your shell:   export $(grep -v '^#' .env | xargs)
#   - pass to Cloud Run:           gcloud run deploy ... --set-env-vars "..."
#   - or use a process manager / python-dotenv if you add it.
# =========================================================================

# --- Database (Cloud SQL / AlloyDB Postgres, or local) --------------------
# Postgres (production target):
#   postgresql://user:pass@host:5432/bupa
# Cloud Run + Cloud SQL unix socket:
#   postgresql://user:pass@/bupa?host=/cloudsql/PROJECT:REGION:INSTANCE
# Local SQLite (zero-setup dev):
#   sqlite:///C:/absolute/path/to/api/bupa.db
DATABASE_URL=sqlite:///./api/bupa.db

# --- Vertex AI (Gemini + MedGemma) ---------------------------------------
# false = deterministic fallback (no cloud calls, demo still works).
# true  = make real Vertex calls (needs GCP_PROJECT + Google credentials).
USE_VERTEX=false
GCP_PROJECT=your-gcp-project-id
GCP_REGION=europe-west2
GEMINI_MODEL=gemini-1.5-flash
# MedGemma dedicated Model Garden endpoint (can be a different region):
MEDGEMMA_ENDPOINT=your-medgemma-endpoint-id
MEDGEMMA_LOCATION=europe-west4

# --- Cloud Storage (uploaded reports) ------------------------------------
UPLOAD_BUCKET=

# --- Pub/Sub (Trigger/Action fan-out) ------------------------------------
PUBSUB_TOPIC=

# --- App tuning -----------------------------------------------------------
SENIOR_AGE_THRESHOLD=65
ASSESSMENT_OVERDUE_MONTHS=12
GUARDRAIL_MIN_CONFIDENCE=0.6
